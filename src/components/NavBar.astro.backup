---
import { NavigationMenu, NavigationMenuList, NavigationMenuItem, NavigationMenuLink } from "@/components/starwind/navigation-menu";
---

<nav class="bg-background text-foreground shadow-sm sticky top-0 z-50" id="navbar">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
    <a href="/" class="text-xl font-semibold hover:opacity-90 transition-opacity">Elbert Cheng</a>
    <NavigationMenu>
      <NavigationMenuList>
        <NavigationMenuItem>
          <NavigationMenuLink href="#home" class="px-3 py-2 rounded-md hover:bg-accent/50 transition-colors">
            Home
          </NavigationMenuLink>
        </NavigationMenuItem>
        <NavigationMenuItem>
          <NavigationMenuLink href="#about" class="px-3 py-2 rounded-md hover:bg-accent/50 transition-colors">
            About
          </NavigationMenuLink>
        </NavigationMenuItem>
        <NavigationMenuItem>
          <NavigationMenuLink href="#experience" class="px-3 py-2 rounded-md hover:bg-accent/50 transition-colors">
            Experience
          </NavigationMenuLink>
        </NavigationMenuItem>
        <NavigationMenuItem>
          <NavigationMenuLink href="#skills" class="px-3 py-2 rounded-md hover:bg-accent/50 transition-colors">
            Skills
          </NavigationMenuLink>
        </NavigationMenuItem>
        <NavigationMenuItem>
          <NavigationMenuLink href="#projects" class="px-3 py-2 rounded-md hover:bg-accent/50 transition-colors">
            Projects
          </NavigationMenuLink>
        </NavigationMenuItem>
      </NavigationMenuList>
    </NavigationMenu>
  </div>
</nav>