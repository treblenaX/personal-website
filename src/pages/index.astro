---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout>
	<NavBar />
	<div class="max-w-6xl mx-auto px-4 py-12">
		<section id="home" class="min-h-screen flex flex-col justify-center">
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-6xl font-bold text-foreground mb-6">Welcome to My Professional Portfolio</h1>
				<p class="text-xl text-muted-foreground max-w-2xl mx-auto">Software Development Engineer with expertise in agentic AI, web development, and teaching</p>
				<div class="mt-8">
					<a href="#about" class="inline-block bg-primary text-primary-foreground font-semibold py-3 px-8 rounded-full shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">Learn More About My Experience</a>
				</div>
			</div>
		</section>
		
		<section id="about" class="min-h-screen flex flex-col justify-center py-12">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-foreground mb-4">About Me</h2>
				<div class="w-24 h-1 bg-primary mx-auto rounded"></div>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Professional Summary</h3>
					<p class="text-muted-foreground mb-4">Software Development Engineer with 3+ years at Amazon, specializing in agentic AI development and software design. Passionate about creating customer-focused solutions and mentoring the next generation of developers.</p>
				</div>
				
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Experience Highlights</h3>
					<ul class="text-muted-foreground space-y-2">
						<li>• Amazon: Software Development Engineer II (2026-present)</li>
						<li>• Amazon: Software Development Engineer (2023-2026)</li>
						<li>• University of Washington: Teaching Assistant (2021-2023)</li>
					</ul>
				</div>
			</div>
		</section>
		
		<section id="experience" class="min-h-screen flex flex-col justify-center py-12">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-foreground mb-4">Professional Experience</h2>
				<div class="w-24 h-1 bg-primary mx-auto rounded"></div>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Amazon - Software Development Engineer</h3>
					<p class="text-primary mb-3">2023 - Present</p>
					<ul class="text-muted-foreground space-y-2">
						<li>• Created, maintained, and expanded features on the Amazon website and mobile app experiences which improved customer experiences</li>
						<li>• Working on the Retail side to help you get your Everyday Essentials—quick!</li>
						<li>• Specializing in Agentic AI Development, Software Design</li>
					</ul>
				</div>
				
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">University of Washington</h3>
					<p class="text-primary mb-3">2021 - 2023</p>
					<ul class="text-muted-foreground space-y-2">
						<li>• Undergraduate Teaching Assistant (INFO 200 & INFO 498)</li>
						<li>• Collaborated with Professor and TA team to develop introductory Informatics course</li>
						<li>• Teaches weekly sections and mentors 100+ students</li>
					</ul>
				</div>
			</div>
		</section>
		
		<section id="skills" class="min-h-screen flex flex-col justify-center py-12">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-foreground mb-4">Technical Skills</h2>
				<div class="w-24 h-1 bg-primary mx-auto rounded"></div>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Programming</h3>
					<ul class="text-muted-foreground space-y-2">
						<li>• TypeScript, JavaScript</li>
						<li>• React.js, Node.js, Angular</li>
						<li>• MongoDB</li>
					</ul>
				</div>
				
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Cloud & Tools</h3>
					<ul class="text-muted-foreground space-y-2">
						<li>• AWS, AWS Glue</li>
						<li>• Heroku</li>
						<li>• Data flow analysis</li>
					</ul>
				</div>
				
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Development</h3>
					<ul class="text-muted-foreground space-y-2">
						<li>• Full-stack development</li>
						<li>• Software design</li>
						<li>• Bug resolution</li>
					</ul>
				</div>
			</div>
		</section>
		
		<section id="projects" class="min-h-screen flex flex-col justify-center py-12">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-foreground mb-4">Notable Projects</h2>
				<div class="w-24 h-1 bg-primary mx-auto rounded"></div>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Amazon Website Enhancements</h3>
					<p class="text-muted-foreground">Improved customer experience through feature development</p>
				</div>
				
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Justice Call Adaptation</h3>
					<p class="text-muted-foreground">Adapted Microsoft's card game into online website</p>
				</div>
				
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Web Solutions Development</h3>
					<p class="text-muted-foreground">Identified and resolved flaws in legacy websites</p>
				</div>
				
				<div class="bg-card rounded-xl shadow-lg p-6 border border-border">
					<h3 class="text-xl font-bold text-foreground mb-3">Small Business Platform</h3>
					<p class="text-muted-foreground">Collaborated on Angular platform with Node.js and MongoDB</p>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	html {
		scroll-behavior: smooth;
	}
	
	/* Navbar styling for seamless blend at top */
	#navbar {
		background-color: #0a0a0a; /* Match content background */
		border-bottom: none;
		transition: all 0.3s ease;
	}
	
	/* Navbar gets border when scrolled */
	#navbar.scrolled {
		border-bottom: 1px solid rgba(100, 120, 255, 0.3);
		background-color: rgba(10, 10, 10, 0.95); /* Slightly transparent for effect */
	}
	
	/* Ensure content background matches navbar background */
	body {
		background-color: #0a0a0a;
	}
</style>

<script>
	// Add scroll effect to navbar
	document.addEventListener('DOMContentLoaded', function() {
		const navbar = document.getElementById('navbar');
		
		window.addEventListener('scroll', function() {
			if (window.scrollY > 50) {
				navbar.classList.add('scrolled');
			} else {
				navbar.classList.remove('scrolled');
			}
		});
	});
</script>
