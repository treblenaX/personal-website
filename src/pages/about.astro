---
import Layout from '../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from "@/components/starwind/card";
import { Button } from "@/components/starwind/button";
---

<Layout>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4">About My Professional Journey</h1>
      <div class="w-24 h-1 bg-primary mx-auto rounded"></div>
    </div>
    
    <Card class="mb-8">
      <CardHeader>
        <CardTitle>Software Development Engineer</CardTitle>
        <CardDescription>
          Amazon | 2023 - Present
        </CardDescription>
      </CardHeader>
      <CardContent>
        <p class="text-lg text-muted-foreground mb-4">Currently working on the Retail side to help you get your Everyday Essentials—quick! Creating, maintaining, and expanding features on the Amazon website and mobile app experiences which improved customer experiences.</p>
        <p class="text-lg text-muted-foreground">Specializing in Agentic AI Development, Software Design, and related technologies.</p>
      </CardContent>
    </Card>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <Card>
        <CardHeader>
          <CardTitle>Teaching Experience</CardTitle>
          <CardDescription>University of Washington Information School</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-muted-foreground mb-3">Undergraduate Teaching Assistant (INFO 200 & INFO 498) | 2021 - 2023</p>
          <ul class="list-disc pl-5 text-muted-foreground space-y-2">
            <li>Collaborated with Professor and TA team to develop introductory Informatics course</li>
            <li>Teach weekly sections and mentor 100+ students</li>
            <li>Guided students through analyzing & designing empathetic IT solutions</li>
          </ul>
        </CardContent>
      </Card>
      
      <Card>
        <CardHeader>
          <CardTitle>Technical Skills</CardTitle>
          <CardDescription>Proficiencies & Expertise</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="list-disc pl-5 text-muted-foreground space-y-2">
            <li>Programming: TypeScript, JavaScript, React.js, Node.js, Angular</li>
            <li>Cloud & Tools: AWS, AWS Glue, Heroku, MongoDB</li>
            <li>Development: Full-stack development, software design, bug resolution</li>
            <li>Other: Data flow analysis, content management systems, agile development</li>
          </ul>
        </CardContent>
      </Card>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <Card>
        <CardHeader>
          <CardTitle>Notable Projects</CardTitle>
          <CardDescription>Key Work Experience</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="list-disc pl-5 text-muted-foreground space-y-2">
            <li>Amazon Website Enhancements</li>
            <li>Justice Call Adaptation</li>
            <li>Web Solutions Development</li>
          </ul>
        </CardContent>
      </Card>
      
      <Card>
        <CardHeader>
          <CardTitle>Internship Experience</CardTitle>
          <CardDescription>Industry Exposure</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="list-disc pl-5 text-muted-foreground space-y-2">
            <li>Microgroove - Developer Consultant</li>
            <li>Symphoni.cc - Software Engineer Intern</li>
            <li>Amazon - Software Development Engineer Intern</li>
          </ul>
        </CardContent>
      </Card>
      
      <Card>
        <CardHeader>
          <CardTitle>Education</CardTitle>
          <CardDescription>University of Washington</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-muted-foreground">Information School</p>
          <p class="text-muted-foreground">Undergraduate Teaching Assistant</p>
        </CardContent>
      </Card>
    </div>
    
    <div class="text-center">
      <Button as="a" href="/" variant="outline">
        Back to Home
      </Button>
    </div>
  </main>
</Layout>